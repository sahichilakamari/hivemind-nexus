# PostgreSQL connection string (Replit provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/hivemind

# Groq API key — get a free key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Personal Access Token (repo scope)
# Used to auto-push generated reports and assets to the repository
# Create one at https://github.com/settings/tokens
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Random secret for session signing (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string
